<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.wesleybritovlk.inertia</groupId>
        <artifactId>inertia-demo</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>inertia-demo-quarkus</artifactId>

    <name>inertia-demo-quarkus</name>
    <description>Hello-world demo over the Quarkus adapter: the same canonical Vite front-ends and pages served by the Quarkus (Undertow + RESTEasy) back-end.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.wesleybritovlk.inertia</groupId>
            <artifactId>inertia-quarkus</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <properties>
        <jacoco.skip>true</jacoco.skip>
        <spotbugs.skip>true</spotbugs.skip>
    </properties>

    <build>
        <finalName>inertia-demo-quarkus</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- the canonical Vite front-ends build into ../frontend-assets (single source:
                 one `npm run build` feeds this app AND the Spring demo). targetPath follows
                 the Servlet spec static-resources location: the Undertow default servlet
                 serves jar META-INF/resources (as does Spring Boot's static locations) -->
            <resource>
                <directory>${project.basedir}/../frontend-assets</directory>
                <targetPath>META-INF/resources</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
