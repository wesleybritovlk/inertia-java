#!/usr/bin/env bash
#
# Git pre-commit hook: runs the full quality gate before every commit.
# Gate: Spotless (formatting) + JaCoCo check (75% instruction/branch) + SpotBugs
# (threshold Normal, effort Max) + the whole test suite.
#
# One-time setup (per clone):
#   git config core.hooksPath .githooks
#
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mvn -B -q verify
