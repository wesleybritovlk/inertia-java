<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.wesleybritovlk.inertia</groupId>
    <artifactId>inertia-java</artifactId>
    <!-- CI-friendly single-source version: property interpolation in parent/version
         blocks accepts ONLY ${revision}/${changelist}/${sha1} (Maven 3.5+), so a
         release version bump edits this property and the whole reactor follows.
         The flatten-maven-plugin resolves ONLY those properties into literal
         versions in every installed pom — required "early", not just for a Central
         release: any resolution outside the root reactor (-pl from a subdirectory,
         quarkus:dev, spring-boot:run) reads the installed poms and chokes on the
         literal "${revision}" parent reference otherwise. -->
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>inertia-java</name>
    <description>Framework-agnostic Inertia.js adapter for Java: server-side driving layer that plugs into Spring Boot (3 and 4) or Quarkus as a plain bean, manipulating only HTTP requests and responses.</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>inertia-core</module>
        <module>inertia-web</module>
        <module>inertia-servlet</module>
        <module>inertia-servlet-javax</module>
        <module>inertia-spring-boot</module>
        <module>inertia-quarkus</module>
        <module>inertia-demo</module>
    </modules>

    <properties>
        <!-- the ONE place a reactor version bump touches -->
        <revision>0.1.0-SNAPSHOT</revision>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>3.3.12</spring.boot.version>
        <junit.version>5.11.4</junit.version>
        <quarkus.platform.version>3.15.3</quarkus.platform.version>
        <thymeleaf.version>3.1.3.RELEASE</thymeleaf.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>

                <!-- code formatting gate, enforced from the validate phase -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>3.10.4</version>
                    <configuration>
                        <java>
                            <removeUnusedImports />
                            <trimTrailingWhitespace />
                            <endWithNewline />
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- bug pattern gate: Normal threshold with Max effort (the user asked to keep
                     SpotBugs strict here) -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.10.5.0</version>
                    <configuration>
                        <threshold>Normal</threshold>
                        <effort>Max</effort>
                        <failOnError>true</failOnError>
                        <xmlOutput>true</xmlOutput>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotbugs-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- dead-code gate: PMD owns the unused-declaration patterns SpotBugs
                     provably does not flag (a never-called private method passed a
                     low-threshold/max-effort SpotBugs run). Main sources only. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.28.0</version>
                    <configuration>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/pmd-deadcode.xml</ruleset>
                        </rulesets>
                        <includeTests>false</includeTests>
                        <analysisCache>true</analysisCache>
                        <printFailingErrors>true</printFailingErrors>
                    </configuration>
                    <executions>
                        <execution>
                            <id>pmd-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- CI-friendly versions need consumer-resolvable poms: flatten resolves ONLY
                     the revision/changelist/sha1 properties into literal versions (non-
                     destructive since 1.7.1) for EVERYTHING that gets installed — otherwise
                     any resolution outside the root reactor (mvn -pl from a subdirectory,
                     quarkus:dev, spring-boot:run) chokes on a parent lookup keyed by the
                     literal "${revision}" string (reproduced from inertia-demo). -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.8.0</version>
                    <configuration>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                        <!-- the root and the demo aggregator are packaging=pom; the default
                             updatePomFile covers only jar packaging -->
                        <updatePomFile>true</updatePomFile>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten-clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- coverage gate: 75% instruction AND branch at bundle level -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.16</version>
                    <executions>
                        <execution>
                            <id>jacoco-prepare</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>INSTRUCTION</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.75</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.75</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- the root pom itself is installed/consumed too; it needs the same
                 CI-friendly resolution its children get -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Boot 4 compatibility benchmark: mvn -Pboot4 verify -->
        <profile>
            <id>boot4</id>
            <properties>
                <spring.boot.version>4.0.5</spring.boot.version>
            </properties>
        </profile>
    </profiles>
</project>
